{
  "name": "beaconmon",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=20.9.0",
    "pnpm": ">=10.25.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "db:generate": "pnpm --filter @beaconmon/db run generate",
    "db:migrate": "pnpm --filter @beaconmon/db run migrate",
    "db:seed": "pnpm --filter @beaconmon/db run seed",
    "db:studio": "pnpm --filter @beaconmon/db run studio",
    "start:web": "pnpm --filter @beaconmon/web run start",
    "web:dev": "pnpm --filter @beaconmon/web run dev",
    "start:worker:checks": "pnpm --filter @beaconmon/workers run start:check",
    "start:worker:content": "pnpm --filter @beaconmon/workers run start:content",
    "start:worker:alerts": "pnpm --filter @beaconmon/workers run start:alert",
    "start:worker:escalation": "pnpm --filter @beaconmon/workers run start:escalation",
    "start:worker:report": "pnpm --filter @beaconmon/workers run start:report",
    "start:worker:digest": "pnpm --filter @beaconmon/workers run start:digest",
    "start:worker:shopify": "pnpm --filter @beaconmon/workers run start:shopify",
    "start:worker:competitor-page": "pnpm --filter @beaconmon/workers run start:competitor-page",
    "start:worker:competitor-notify": "pnpm --filter @beaconmon/workers run start:competitor-notify",
    "start:worker:lifecycle-email": "pnpm --filter @beaconmon/workers run start:lifecycle-email",
    "start:scheduler": "pnpm --filter @beaconmon/workers run start:scheduler",
    "smoke-test": "tsx scripts/smoke-test.ts",
    "frame-screenshot": "tsx apps/web/scripts/frame-screenshot.ts",
    "make-demo": "bash scripts/make-demo.sh"
  },
  "devDependencies": {
    "tsx": "^4.21.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.17",
      "@types/react-dom": "19.2.3"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "msgpackr-extract",
      "prisma",
      "unrs-resolver"
    ]
  }
}
