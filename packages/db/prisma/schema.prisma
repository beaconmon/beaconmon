generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MonitorType {
  http
  ssl
  domain
  tcp
  keyword
  content
  heartbeat
}

enum MonitorStatus {
  up
  down
  paused
}

enum KeywordCondition {
  present
  absent
}

enum TeamRole {
  owner
  admin
  viewer
}

enum PlanTier {
  free
  starter
  growth
  scale
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
}

enum BillingPeriod {
  monthly
  annual
}

enum ResolutionType {
  automatic
  manual
}

enum AlertChannelType {
  email
  slack
  webhook
  sms
  discord
}

enum ExpiryAlertType {
  ssl
  domain
}

enum NotificationKind {
  down
  up
}

// ─── Teams & Users ────────────────────────────────────────────────────────────

model Team {
  id          String    @id @default(cuid())
  name        String
  plan        PlanTier  @default(free)
  trialEndsAt           DateTime? @map("trial_ends_at")
  trialEndProcessedAt   DateTime? @map("trial_end_processed_at")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Report branding (agency white-label)
  reportLogoUrl    String? @map("report_logo_url")
  reportBrandColor String? @map("report_brand_color")
  reportAgencyName String? @map("report_agency_name")

  // Fallback escalation policy used when a monitor has no policy assigned.
  defaultEscalationPolicyId String? @map("default_escalation_policy_id")

  // Intelligence Digest preferences (frequency, opted-in channels, section toggles)
  digestPrefs Json? @map("digest_prefs")

  members                     TeamMember[]
  invitations                 TeamInvitation[]
  subscription                Subscription?
  monitors                    Monitor[]
  alertChannels               AlertChannel[]
  incidents                   Incident[]
  expiryAlerts                ExpiryAlert[]
  notifications               Notification[]
  statusPages                 StatusPage[]
  maintenanceWindows          MaintenanceWindow[]
  escalationPolicies          EscalationPolicy[]
  defaultEscalationPolicy     EscalationPolicy?            @relation("TeamDefaultEscalationPolicy", fields: [defaultEscalationPolicyId], references: [id], onDelete: SetNull)
  deployEvents                DeployEvent[]
  contentSnapshots            ContentSnapshot[]
  notificationReadStates      NotificationReadState[]
  userNotificationPreferences UserNotificationPreference[]
  performanceAlerts           PerformanceAlert[]
  competitors                      Competitor[]
  competitorPages                  CompetitorPage[]
  competitorProducts               CompetitorProduct[]
  competitorEvents                 CompetitorEvent[]
  competitorDecisions              CompetitorDecision[]
  competitorNotificationChannels   CompetitorNotificationChannel[]
  monitoringRuns                   MonitoringRun[]
  lifecycleEmailSends              LifecycleEmailSend[]
  emailUnsubscribes                EmailUnsubscribe[]

  @@map("teams")
}

model User {
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false) @map("email_verified")
  image           String?
  lastLoginMethod String?  @map("last_login_method")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  memberships              TeamMember[]
  sessions                 Session[]
  accounts                 Account[]
  notificationReadStates   NotificationReadState[]
  alertChannels            AlertChannel[]
  notificationPreferences  UserNotificationPreference[]
  escalationStepRecipients EscalationStepRecipient[]

  @@map("users")
}

// Better Auth tables
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

model TeamMember {
  id                      String    @id @default(cuid())
  teamId                  String    @map("team_id")
  userId                  String    @map("user_id")
  role                    TeamRole  @default(viewer)
  intelligenceLastSeenAt  DateTime? @map("intelligence_last_seen_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamInvitation {
  id         String    @id @default(cuid())
  teamId     String    @map("team_id")
  email      String
  role       TeamRole  @default(viewer)
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_invitations")
}

model Subscription {
  id                     String             @id @default(cuid())
  teamId                 String             @unique @map("team_id")
  freemiusUserId         String             @unique @map("freemius_user_id")
  freemiusSubscriptionId String?            @unique @map("freemius_subscription_id")
  plan                   PlanTier           @default(free)
  status                 SubscriptionStatus @default(trialing)
  billingPeriod          BillingPeriod      @default(monthly) @map("billing_period")
  trialEndsAt            DateTime?          @map("trial_ends_at")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── Monitors ─────────────────────────────────────────────────────────────────

model Monitor {
  id                  String        @id @default(cuid())
  teamId              String        @map("team_id")
  name                String
  url                 String
  type                MonitorType
  isActive            Boolean       @default(true) @map("is_active")
  currentStatus       MonitorStatus @default(up) @map("current_status")
  intervalSeconds     Int           @default(300) @map("interval_seconds")
  timeoutMs           Int           @default(30000) @map("timeout_ms")
  nextCheckAt         DateTime?     @map("next_check_at")
  lastCheckedAt       DateTime?     @map("last_checked_at")
  consecutiveFailures Int           @default(0) @map("consecutive_failures")

  // HTTP / keyword extras
  responseTimeThresholdMs Int?              @map("response_time_threshold_ms")
  keyword                 String?
  keywordCondition        KeywordCondition? @map("keyword_condition")

  // Content monitor
  contentSnapshot      String?   @map("content_snapshot")
  contentLastChangedAt DateTime? @map("content_last_changed_at")

  // Heartbeat monitor
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")

  // Escalation policy (optional — overrides default alert channel broadcast)
  escalationPolicyId String? @map("escalation_policy_id")

  // Anomaly detection
  anomalyDetectionEnabled Boolean @default(false) @map("anomaly_detection_enabled")

  // SLO / Error Budget
  sloTarget                Decimal? @map("slo_target") @db.Decimal(6, 4) // e.g. 0.9990 for 99.9%
  sloWindowDays            Int?     @map("slo_window_days") // rolling window, default 30
  sloBurnRateFastThreshold Float?   @map("slo_burn_rate_fast_threshold") // default 14.4
  sloBurnRateSlowThreshold Float?   @map("slo_burn_rate_slow_threshold") // default 3.0

  // Type-specific config (port, selector, gracePeriodSeconds for heartbeat, etc.)
  config Json @default("{}")

  // User-defined tags for filtering and grouping (e.g. "production", "us-east")
  tags String[] @default([])

  isCompetitor Boolean   @default(false) @map("is_competitor")
  pausedReason String?   @map("paused_reason")
  pausedAt     DateTime? @map("paused_at")

  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team                      Team                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  escalationPolicy          EscalationPolicy?          @relation(fields: [escalationPolicyId], references: [id])
  checkResults              CheckResult[]
  incidents                 Incident[]
  expiryAlerts              ExpiryAlert[]
  statusPageMonitors        StatusPageMonitor[]
  maintenanceWindowMonitors MaintenanceWindowMonitor[]
  deployEvents              DeployEvent[]
  contentSnapshots          ContentSnapshot[]
  performanceAlerts         PerformanceAlert[]

  // Partial index (is_active = true) is created in migration 0001 as raw SQL
  @@map("monitors")
}

// ─── Check Results (partitioned — see migration 0001_init) ───────────────────
// Prisma maps to the partition parent table for type generation only.
// Actual partitioned DDL is in migration 0001_init.

model CheckResult {
  id             String   @id @default(cuid())
  monitorId      String   @map("monitor_id")
  checkedAt      DateTime @default(now()) @map("checked_at")
  success        Boolean
  statusCode     Int?     @map("status_code")
  responseTimeMs Int?     @map("response_time_ms")
  errorType      String?  @map("error_type")
  errorMessage   String?  @map("error_message")
  region         String? // null = Railway-only check (SSL/TCP/domain)
  maintenance    Boolean  @default(false) // true when check ran during a maintenance window

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("check_results")
}

// ─── Incidents ────────────────────────────────────────────────────────────────

model Incident {
  id             String          @id @default(cuid())
  teamId         String          @map("team_id")
  monitorId      String          @map("monitor_id")
  startedAt      DateTime        @default(now()) @map("started_at")
  resolvedAt     DateTime?       @map("resolved_at")
  resolutionType ResolutionType? @map("resolution_type")
  acknowledgedAt DateTime?       @map("acknowledged_at")
  acknowledgedBy String?         @map("acknowledged_by")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitor       Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([teamId, startedAt(sort: Desc)])
  @@map("incidents")
}

// ─── Expiry Alerts (SSL + domain) ─────────────────────────────────────────────

model ExpiryAlert {
  id            String          @id @default(cuid())
  teamId        String          @map("team_id")
  monitorId     String          @map("monitor_id")
  type          ExpiryAlertType
  daysRemaining Int             @map("days_remaining")
  threshold     Int
  sentAt        DateTime        @default(now()) @map("sent_at")
  createdAt     DateTime        @default(now()) @map("created_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("expiry_alerts")
}

// ─── Alert Channels ───────────────────────────────────────────────────────────

model AlertChannel {
  id             String           @id @default(cuid())
  teamId         String           @map("team_id")
  // When set, this is a personal channel owned by a specific user (e.g. their
  // own email or Slack DM). Personal channels do NOT appear in the team-wide
  // channel picker; they're targeted indirectly via user-recipients on
  // escalation steps and the user's notification preferences.
  userId         String?          @map("user_id")
  name           String
  type           AlertChannelType
  config         Json             @default("{}")
  isActive       Boolean          @default(true) @map("is_active")
  // System-disabled (e.g. plan downgrade leaves surplus channels). Distinct from
  // user-controlled `isActive`. Alert worker treats either as "skip".
  disabledAt     DateTime?        @map("disabled_at")
  disabledReason String?          @map("disabled_reason")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  team                          Team                          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user                          User?                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications                 Notification[]
  escalationStepRecipients      EscalationStepRecipient[]
  primaryForPreferences         UserNotificationPreference[]
  competitorNotificationChannels CompetitorNotificationChannel[]

  @@index([teamId, userId])
  @@map("alert_channels")
}

// ─── Notifications (idempotency log) ─────────────────────────────────────────

model Notification {
  id               String           @id @default(cuid())
  teamId           String           @map("team_id")
  incidentId       String           @map("incident_id")
  channelId        String           @map("channel_id")
  kind             NotificationKind @default(down)
  // 5-minute floored bucket (app-computed). The unique index below makes the
  // (incidentId, channelId, kind, sentWindowBucket) tuple atomically claim-able
  // so two concurrent retries can't both pass dedup and both send.
  sentWindowBucket DateTime         @map("sent_window_bucket")
  // Null = row is a "claim" placed before send; populated = send completed.
  sentAt           DateTime?        @map("sent_at")
  createdAt        DateTime         @default(now()) @map("created_at")

  team     Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  incident Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel  AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([incidentId, channelId, kind, sentWindowBucket], map: "notifications_idem_unique")
  @@index([incidentId, channelId, sentAt(sort: Desc)])
  @@map("notifications")
}

// ─── Status Pages ─────────────────────────────────────────────────────────────

model StatusPage {
  id                   String   @id @default(cuid())
  teamId               String   @map("team_id")
  name                 String
  slug                 String   @unique
  customDomain          String?  @map("custom_domain")
  customDomainVerified  Boolean  @default(false) @map("custom_domain_verified")
  detectedDnsProvider   String?  @map("detected_dns_provider")
  cloudflareHostnameId  String?  @map("cloudflare_hostname_id")
  isPublic             Boolean  @default(true) @map("is_public")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  team     Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitors StatusPageMonitor[]

  // Partial unique index (custom_domain IS NOT NULL) is created in migration 0001 as raw SQL
  @@map("status_pages")
}

model StatusPageMonitor {
  id           String @id @default(cuid())
  statusPageId String @map("status_page_id")
  monitorId    String @map("monitor_id")
  displayOrder Int    @default(0) @map("display_order")

  statusPage StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  monitor    Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([statusPageId, monitorId])
  @@map("status_page_monitors")
}

// ─── Maintenance Windows ───────────────────────────────────────────────────────

model MaintenanceWindow {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  team     Team                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitors MaintenanceWindowMonitor[]

  @@index([teamId, endsAt(sort: Desc)])
  @@map("maintenance_windows")
}

model MaintenanceWindowMonitor {
  id        String @id @default(cuid())
  windowId  String @map("window_id")
  monitorId String @map("monitor_id")

  window  MaintenanceWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  monitor Monitor           @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([windowId, monitorId])
  @@map("maintenance_window_monitors")
}

// ─── Notification feed read state ─────────────────────────────────────────────

model NotificationReadState {
  id         String   @id @default(cuid())
  teamId     String   @map("team_id")
  userId     String   @map("user_id")
  lastSeenAt DateTime @map("last_seen_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("notification_read_state")
}

// ─── Escalation Policies ──────────────────────────────────────────────────────

model EscalationPolicy {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  name      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  steps           EscalationStep[]
  monitors        Monitor[]
  defaultForTeams Team[]           @relation("TeamDefaultEscalationPolicy")

  @@map("escalation_policies")
}

model EscalationStep {
  id           String @id @default(cuid())
  policyId     String @map("policy_id")
  stepOrder    Int    @map("step_order")
  delayMinutes Int    @map("delay_minutes")

  policy     EscalationPolicy          @relation(fields: [policyId], references: [id], onDelete: Cascade)
  recipients EscalationStepRecipient[]

  @@unique([policyId, stepOrder])
  @@map("escalation_steps")
}

// Each step can target multiple recipients in parallel: direct alert channels
// AND/OR specific users (whose alerts route through their personal primary
// channel at send time). Either channelId or userId is set, not both.
// `removedAt` is stamped (and userId nulled) when a user is removed from the
// team — the row is preserved for UI continuity ("Removed user").
model EscalationStepRecipient {
  id        String    @id @default(cuid())
  stepId    String    @map("step_id")
  channelId String?   @map("channel_id")
  userId    String?   @map("user_id")
  removedAt DateTime? @map("removed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  step    EscalationStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  channel AlertChannel?  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@index([userId])
  @@map("escalation_step_recipients")
}

// Per-user notification routing within a team. When a user appears as a
// recipient on an escalation step, the worker resolves their primary channel
// here. Null primaryChannelId means: fall back to the user's account email
// (lazily upserted into a personal alert channel on first use).
model UserNotificationPreference {
  id               String   @id @default(cuid())
  userId           String   @map("user_id")
  teamId           String   @map("team_id")
  primaryChannelId String?  @map("primary_channel_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  team           Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  primaryChannel AlertChannel? @relation(fields: [primaryChannelId], references: [id], onDelete: SetNull)

  @@unique([userId, teamId])
  @@map("user_notification_preferences")
}

// ─── Performance Alerts (anomaly detection) ────────────────────────────────────

model PerformanceAlert {
  id             String    @id @default(cuid())
  teamId         String    @map("team_id")
  monitorId      String    @map("monitor_id")
  checkedAt      DateTime  @map("checked_at")
  responseTimeMs Int       @map("response_time_ms")
  meanMs         Float     @map("mean_ms")
  stdDevMs       Float     @map("std_dev_ms")
  zScore         Float     @map("z_score")
  notifiedAt     DateTime? @map("notified_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, checkedAt(sort: Desc)])
  @@map("performance_alerts")
}

// ─── Deploy Events (deploy-aware monitoring) ──────────────────────────────────

model DeployEvent {
  id             String    @id @default(cuid())
  monitorId      String    @map("monitor_id")
  teamId         String    @map("team_id")
  startedAt      DateTime  @default(now()) @map("started_at")
  endedAt        DateTime? @map("ended_at")
  commitSha      String?   @map("commit_sha")
  description    String?
  suppressAlerts Boolean   @default(true) @map("suppress_alerts")
  createdAt      DateTime  @default(now()) @map("created_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, startedAt(sort: Desc)])
  @@map("deploy_events")
}

// ─── Webhook Deduplication ────────────────────────────────────────────────────

model ProcessedWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now()) @map("processed_at")

  @@index([processedAt])
  @@map("processed_webhook_events")
}

// ─── Content Snapshots (history for content monitors) ─────────────────────────

model ContentSnapshot {
  id               String    @id @default(cuid())
  monitorId        String?   @map("monitor_id")
  competitorPageId String?   @map("competitor_page_id")
  teamId           String    @map("team_id")
  content          String
  contentHash      String?   @map("content_hash")
  capturedAt       DateTime  @default(now()) @map("captured_at")
  diffSummary      String?   @map("diff_summary")
  classification   String?   @map("classification")
  aiConfidence     Float?    @map("ai_confidence")
  aiModel          String?   @map("ai_model")
  aiAnalyzedAt     DateTime? @map("ai_analyzed_at")

  team           Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitor        Monitor?         @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  competitorPage CompetitorPage?  @relation(fields: [competitorPageId], references: [id], onDelete: Cascade)

  @@index([monitorId, capturedAt(sort: Desc)])
  @@index([competitorPageId, capturedAt(sort: Desc)])
  @@map("content_snapshots")
}

// ─── Competitor Intelligence ───────────────────────────────────────────────────

model Competitor {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  name      String
  domain    String
  platform          String    // 'shopify' | 'woocommerce' | 'other'
  discoveryState    String    @default("pending") @map("discovery_state") // 'pending' | 'syncing' | 'ready' | 'failed' | 'not_applicable'
  discoverySyncedAt DateTime? @map("discovery_synced_at")
  discoveryError    String?   @map("discovery_error")
  isActive          Boolean   @default(true) @map("is_active")
  deletedAt         DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  team                 Team                            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pages                CompetitorPage[]
  products             CompetitorProduct[]
  events               CompetitorEvent[]
  notificationChannels CompetitorNotificationChannel[]

  @@map("competitors")
}

model CompetitorPage {
  id               String    @id @default(cuid())
  competitorId     String    @map("competitor_id")
  teamId           String    @map("team_id")
  label            String
  url              String
  selector         String?
  intervalSeconds  Int       @default(3600) @map("interval_seconds")
  isActive         Boolean   @default(true) @map("is_active")
  lastSnapshotHash String?   @map("last_snapshot_hash")
  lastCheckedAt    DateTime? @map("last_checked_at")
  nextCheckAt      DateTime? @map("next_check_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  competitor Competitor        @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  snapshots  ContentSnapshot[]
  events     CompetitorEvent[]

  @@map("competitor_pages")
}

model CompetitorProduct {
  id               String   @id @default(cuid())
  competitorId     String   @map("competitor_id")
  teamId           String   @map("team_id")
  shopifyProductId String   @map("shopify_product_id")
  title            String
  handle           String
  sku              String?
  gtin             String?
  vendor           String?
  productType      String?  @map("product_type")
  isAvailable      Boolean  @default(true) @map("is_available")
  variants         Json     @default("[]")
  currentPrice     Decimal? @map("current_price") @db.Decimal(10, 2)
  compareAtPrice   Decimal? @map("compare_at_price") @db.Decimal(10, 2)
  currency         String   @default("USD")
  lastSeenAt       DateTime @default(now()) @map("last_seen_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  competitor Competitor        @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  events     CompetitorEvent[]

  @@unique([competitorId, shopifyProductId])
  @@map("competitor_products")
}

model CompetitorEvent {
  id           String   @id @default(cuid())
  teamId       String   @map("team_id")
  competitorId String   @map("competitor_id")
  productId    String?  @map("product_id")
  pageId       String?  @map("page_id")
  type         String
  // 'product_added' | 'product_removed' | 'price_changed' | 'stock_changed' | 'site_changed' | 'promo_detected'
  payload      Json     @default("{}")
  significance String?
  // 'low' | 'medium' | 'high' — null treated as medium
  detectedAt   DateTime @map("detected_at")
  createdAt    DateTime @default(now()) @map("created_at")

  competitor Competitor         @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  team       Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  product    CompetitorProduct? @relation(fields: [productId], references: [id])
  page       CompetitorPage?    @relation(fields: [pageId], references: [id])
  decision   CompetitorDecision?

  @@index([teamId, detectedAt(sort: Desc)])
  @@index([competitorId, detectedAt(sort: Desc)])
  @@index([teamId, significance, detectedAt(sort: Desc)])
  @@map("competitor_events")
}

model CompetitorDecision {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  eventId   String   @unique @map("event_id")
  response  String   // 'ignore' | 'match' | 'counter' | 'leapfrog'
  note      String?
  decidedBy String   @map("decided_by")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  event CompetitorEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team  Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("competitor_decisions")
}

model CompetitorNotificationChannel {
  id           String   @id @default(cuid())
  competitorId String   @map("competitor_id")
  channelId    String   @map("channel_id")
  teamId       String   @map("team_id")
  createdAt    DateTime @default(now()) @map("created_at")

  competitor Competitor   @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  channel    AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  team       Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([competitorId, channelId])
  @@index([teamId])
  @@map("competitor_notification_channels")
}

model MonitoringRun {
  id           String   @id @default(cuid())
  teamId       String   @map("team_id")
  jobType      String   @map("job_type")
  jobId        String   @map("job_id")
  status       String
  startedAt    DateTime @map("started_at")
  finishedAt   DateTime @map("finished_at")
  errorMessage String?  @map("error_message")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, finishedAt(sort: Desc)])
  @@index([finishedAt])
  @@map("monitoring_runs")
}

// ─── Lifecycle Emails ─────────────────────────────────────────────────────────

model LifecycleEmailSend {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  emailType String   @map("email_type")
  sentAt    DateTime @default(now()) @map("sent_at")
  dedupKey  String   @unique @map("dedup_key")
  status    String   @default("sent")
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, sentAt(sort: Desc)])
  @@map("lifecycle_email_sends")
}

model EmailUnsubscribe {
  id             String   @id @default(cuid())
  teamId         String   @map("team_id")
  category       String
  unsubscribedAt DateTime @default(now()) @map("unsubscribed_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, category])
  @@map("email_unsubscribes")
}
