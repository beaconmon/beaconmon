generator client {
  provider = "prisma-client"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum MonitorType {
  http
  ssl
  domain
  tcp
  keyword
  content
  heartbeat
}

enum MonitorStatus {
  up
  down
  paused
}

enum KeywordCondition {
  present
  absent
}

enum TeamRole {
  owner
  admin
  viewer
}

enum PlanTier {
  free
  pro
  business
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  canceled
  incomplete
}

enum ResolutionType {
  automatic
  manual
}

enum AlertChannelType {
  email
  slack
  webhook
  sms
  discord
}

enum ExpiryAlertType {
  ssl
  domain
}

// ─── Teams & Users ────────────────────────────────────────────────────────────

model Team {
  id          String    @id @default(cuid())
  name        String
  plan        PlanTier  @default(free)
  trialEndsAt DateTime? @map("trial_ends_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  members        TeamMember[]
  invitations    TeamInvitation[]
  subscription   Subscription?
  monitors       Monitor[]
  alertChannels  AlertChannel[]
  incidents      Incident[]
  expiryAlerts   ExpiryAlert[]
  notifications  Notification[]
  statusPages    StatusPage[]
  maintenanceWindows MaintenanceWindow[]

  @@map("teams")
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  memberships TeamMember[]
  sessions    Session[]
  accounts    Account[]

  @@map("users")
}

// Better Auth tables
model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("verifications")
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  userId    String   @map("user_id")
  role      TeamRole @default(viewer)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model TeamInvitation {
  id         String    @id @default(cuid())
  teamId     String    @map("team_id")
  email      String
  role       TeamRole  @default(viewer)
  token      String    @unique
  expiresAt  DateTime  @map("expires_at")
  acceptedAt DateTime? @map("accepted_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("team_invitations")
}

model Subscription {
  id                    String             @id @default(cuid())
  teamId                String             @unique @map("team_id")
  paddleCustomerId      String             @unique @map("paddle_customer_id")
  paddleSubscriptionId  String?            @unique @map("paddle_subscription_id")
  plan                  PlanTier           @default(free)
  status                SubscriptionStatus @default(trialing)
  trialEndsAt           DateTime?          @map("trial_ends_at")
  currentPeriodEnd      DateTime?          @map("current_period_end")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@map("subscriptions")
}

// ─── Monitors ─────────────────────────────────────────────────────────────────

model Monitor {
  id            String        @id @default(cuid())
  teamId        String        @map("team_id")
  name          String
  url           String
  type          MonitorType
  isActive      Boolean       @default(true) @map("is_active")
  currentStatus MonitorStatus @default(up) @map("current_status")
  intervalSeconds Int         @default(300) @map("interval_seconds")
  timeoutMs     Int           @default(30000) @map("timeout_ms")
  nextCheckAt   DateTime?     @map("next_check_at")
  lastCheckedAt DateTime?     @map("last_checked_at")
  consecutiveFailures Int     @default(0) @map("consecutive_failures")

  // HTTP / keyword extras
  responseTimeThresholdMs Int?             @map("response_time_threshold_ms")
  keyword                 String?
  keywordCondition        KeywordCondition? @map("keyword_condition")

  // Content monitor
  contentSnapshot       String?   @map("content_snapshot")
  contentLastChangedAt  DateTime? @map("content_last_changed_at")
  requiresJs            Boolean   @default(false) @map("requires_js")

  // Heartbeat monitor
  lastHeartbeatAt DateTime? @map("last_heartbeat_at")

  // Type-specific config (port, selector, gracePeriodSeconds for heartbeat, etc.)
  config Json @default("{}")

  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team              Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  checkResults      CheckResult[]
  incidents         Incident[]
  expiryAlerts      ExpiryAlert[]
  statusPageMonitors StatusPageMonitor[]
  maintenanceWindowMonitors MaintenanceWindowMonitor[]

  // Partial index (is_active = true) is created in migration 0001 as raw SQL
  @@map("monitors")
}

// ─── Check Results (partitioned — see migration 0002) ─────────────────────────
// Prisma maps to the partition parent table for type generation only.
// Actual partitioned DDL is in migration 0002_check_results_partition.

model CheckResult {
  id            String   @id @default(cuid())
  monitorId     String   @map("monitor_id")
  checkedAt     DateTime @default(now()) @map("checked_at")
  success       Boolean
  statusCode    Int?     @map("status_code")
  responseTimeMs Int?    @map("response_time_ms")
  errorType     String?  @map("error_type")
  errorMessage  String?  @map("error_message")
  region        String?  // null = Railway-only check (SSL/TCP/domain)
  maintenance   Boolean  @default(false) // true when check ran during a maintenance window

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("check_results")
}

// ─── Incidents ────────────────────────────────────────────────────────────────

model Incident {
  id             String          @id @default(cuid())
  teamId         String          @map("team_id")
  monitorId      String          @map("monitor_id")
  startedAt      DateTime        @default(now()) @map("started_at")
  resolvedAt     DateTime?       @map("resolved_at")
  resolutionType ResolutionType? @map("resolution_type")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitor       Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@index([teamId, startedAt(sort: Desc)])
  @@map("incidents")
}

// ─── Expiry Alerts (SSL + domain) ─────────────────────────────────────────────

model ExpiryAlert {
  id           String          @id @default(cuid())
  teamId       String          @map("team_id")
  monitorId    String          @map("monitor_id")
  type         ExpiryAlertType
  daysRemaining Int            @map("days_remaining")
  threshold    Int
  sentAt       DateTime        @default(now()) @map("sent_at")
  createdAt    DateTime        @default(now()) @map("created_at")

  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@map("expiry_alerts")
}

// ─── Alert Channels ───────────────────────────────────────────────────────────

model AlertChannel {
  id        String           @id @default(cuid())
  teamId    String           @map("team_id")
  name      String
  type      AlertChannelType
  config    Json             @default("{}")
  isActive  Boolean          @default(true) @map("is_active")
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@map("alert_channels")
}

// ─── Notifications (idempotency log) ─────────────────────────────────────────

model Notification {
  id         String   @id @default(cuid())
  teamId     String   @map("team_id")
  incidentId String   @map("incident_id")
  channelId  String   @map("channel_id")
  sentAt     DateTime @default(now()) @map("sent_at")
  createdAt  DateTime @default(now()) @map("created_at")

  team     Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  incident Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  channel  AlertChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@index([incidentId, channelId, sentAt(sort: Desc)])
  @@map("notifications")
}

// ─── Status Pages ─────────────────────────────────────────────────────────────

model StatusPage {
  id                    String   @id @default(cuid())
  teamId                String   @map("team_id")
  name                  String
  slug                  String   @unique
  customDomain          String?  @map("custom_domain")
  customDomainVerified  Boolean  @default(false) @map("custom_domain_verified")
  isPublic              Boolean  @default(true) @map("is_public")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  team     Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitors StatusPageMonitor[]

  // Partial unique index (custom_domain IS NOT NULL) is created in migration 0001 as raw SQL
  @@map("status_pages")
}

model StatusPageMonitor {
  id           String @id @default(cuid())
  statusPageId String @map("status_page_id")
  monitorId    String @map("monitor_id")
  displayOrder Int    @default(0) @map("display_order")

  statusPage StatusPage @relation(fields: [statusPageId], references: [id], onDelete: Cascade)
  monitor    Monitor    @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([statusPageId, monitorId])
  @@map("status_page_monitors")
}

// ─── Maintenance Windows ───────────────────────────────────────────────────────

model MaintenanceWindow {
  id        String   @id @default(cuid())
  teamId    String   @map("team_id")
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  reason    String?
  createdAt DateTime @default(now()) @map("created_at")

  team     Team                       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  monitors MaintenanceWindowMonitor[]

  @@index([teamId, endsAt(sort: Desc)])
  @@map("maintenance_windows")
}

model MaintenanceWindowMonitor {
  id        String @id @default(cuid())
  windowId  String @map("window_id")
  monitorId String @map("monitor_id")

  window  MaintenanceWindow @relation(fields: [windowId], references: [id], onDelete: Cascade)
  monitor Monitor           @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([windowId, monitorId])
  @@map("maintenance_window_monitors")
}
