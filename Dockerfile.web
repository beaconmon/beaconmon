# syntax=docker/dockerfile:1.7
#
# Web-only image. Uses Next.js standalone output — the runner stage carries
# only the traced runtime files, not the full node_modules tree.

############################################
# Base — Node + pnpm + native build deps
############################################
FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat openssl tini
RUN corepack enable && corepack prepare pnpm@10.25.0 --activate
WORKDIR /app

############################################
# Deps — restore workspace dependencies
# Cached unless any package.json or the lockfile changes.
############################################
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc package.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/workers/package.json ./apps/workers/
COPY apps/region-probe/package.json ./apps/region-probe/
COPY packages/ai/package.json ./packages/ai/
COPY packages/billing/package.json ./packages/billing/
COPY packages/checker/package.json ./packages/checker/
COPY packages/db/package.json ./packages/db/
COPY packages/logger/package.json ./packages/logger/
COPY packages/queue/package.json ./packages/queue/
COPY packages/status-pages/package.json ./packages/status-pages/
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/types/package.json ./packages/types/
RUN --mount=type=cache,id=pnpm-web,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

############################################
# Builder — generate Prisma client + build Next.js
############################################
FROM base AS builder
ENV NEXT_TELEMETRY_DISABLED=1
ARG SENTRY_AUTH_TOKEN
ENV SENTRY_AUTH_TOKEN=$SENTRY_AUTH_TOKEN
ARG NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN
ARG NEXT_PUBLIC_FREEMIUS_PRODUCT_ID
ENV NEXT_PUBLIC_FREEMIUS_PRODUCT_ID=$NEXT_PUBLIC_FREEMIUS_PRODUCT_ID
ARG NEXT_PUBLIC_FREEMIUS_PRO_PLAN_ID
ENV NEXT_PUBLIC_FREEMIUS_PRO_PLAN_ID=$NEXT_PUBLIC_FREEMIUS_PRO_PLAN_ID
ARG NEXT_PUBLIC_FREEMIUS_BUSINESS_PLAN_ID
ENV NEXT_PUBLIC_FREEMIUS_BUSINESS_PLAN_ID=$NEXT_PUBLIC_FREEMIUS_BUSINESS_PLAN_ID
ARG NEXT_PUBLIC_POSTHOG_KEY
ENV NEXT_PUBLIC_POSTHOG_KEY=$NEXT_PUBLIC_POSTHOG_KEY
ARG NEXT_PUBLIC_POSTHOG_HOST
ENV NEXT_PUBLIC_POSTHOG_HOST=$NEXT_PUBLIC_POSTHOG_HOST
ARG NEXT_PUBLIC_CUSTOM_DOMAIN_CNAME_TARGET
ENV NEXT_PUBLIC_CUSTOM_DOMAIN_CNAME_TARGET=$NEXT_PUBLIC_CUSTOM_DOMAIN_CNAME_TARGET
COPY --from=deps /app ./
COPY . .
RUN pnpm --filter @beaconmon/db exec prisma generate
RUN pnpm --filter @beaconmon/web run build

############################################
# Runner — minimal standalone image
# Contains only the traced runtime files, static assets, and public directory.
# No node_modules from the monorepo — Next.js standalone bundles what it needs.
############################################
FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -S app && adduser -S app -G app

# With outputFileTracingRoot at the monorepo root, standalone preserves the
# relative path: apps/web/server.js is the entry point.
COPY --from=builder --chown=app:app /app/apps/web/.next/standalone ./
COPY --from=builder --chown=app:app /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=app:app /app/apps/web/public ./apps/web/public

USER app
EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "apps/web/server.js"]
