# syntax=docker/dockerfile:1.7
#
# Shopify embedded app image (React Router 7 / @shopify/shopify-app-react-router).
# Unlike the Next.js web image there is no standalone trace output, so the runner
# carries node_modules + the react-router build output and serves it directly.

############################################
# Base — Node + pnpm + native build deps
############################################
FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat openssl tini
RUN corepack enable && corepack prepare pnpm@10.25.0 --activate
WORKDIR /app

############################################
# Deps — restore workspace dependencies
# All package.json files are required — pnpm validates the full workspace
# against the lockfile.
############################################
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc package.json ./
COPY apps/web/package.json ./apps/web/
COPY apps/workers/package.json ./apps/workers/
COPY apps/region-probe/package.json ./apps/region-probe/
COPY apps/shopify/package.json ./apps/shopify/
COPY packages/ai/package.json ./packages/ai/
COPY packages/billing/package.json ./packages/billing/
COPY packages/checker/package.json ./packages/checker/
COPY packages/db/package.json ./packages/db/
COPY packages/emails/package.json ./packages/emails/
COPY packages/logger/package.json ./packages/logger/
COPY packages/queue/package.json ./packages/queue/
COPY packages/status-pages/package.json ./packages/status-pages/
COPY packages/tsconfig/package.json ./packages/tsconfig/
COPY packages/types/package.json ./packages/types/
RUN --mount=type=cache,id=pnpm-shopify,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile

############################################
# Builder — generate Prisma client + build the React Router app
############################################
FROM base AS builder
COPY --from=deps /app ./
COPY . .
RUN pnpm --filter @beaconmon/db exec prisma generate
RUN pnpm --filter @beaconmon/shopify run build

############################################
# Runner — node_modules + build output, served by react-router-serve
# pnpm workspace symlinks in node_modules point into packages/, so the whole
# /app tree (deps + built source + generated Prisma client) is carried over.
############################################
FROM base AS runner
ENV NODE_ENV=production
ENV PORT=3000

COPY --from=builder /app ./

RUN addgroup -S app && adduser -S app -G app && chown -R app:app /app
USER app
EXPOSE 3000

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["pnpm", "--filter", "@beaconmon/shopify", "run", "start"]
