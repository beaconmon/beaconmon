# Shopify app credentials (from the Partners dashboard / Dev Dashboard).
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=

# Public URL the app is served from. Set by `shopify app dev` locally.
SHOPIFY_APP_URL=https://shopify.beaconmon.com

# Minimal scopes. ZERO Protected Customer Data: never add orders or customers.
SCOPES=read_products,read_inventory

# Shared monorepo database. The app uses the pooled URL in production and falls
# back to the direct URL locally (see @beaconmon/db).
DATABASE_URL_POOLED=
DATABASE_URL=

# Redis (shared BullMQ instance).
REDIS_URL=

# Optional: custom dev store domain for local testing.
# SHOP_CUSTOM_DOMAIN=
