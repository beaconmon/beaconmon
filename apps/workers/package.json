{
  "name": "@beaconmon/workers",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start:check": "tsx check-worker.ts",
    "start:content": "tsx content-worker.ts",
    "start:alert": "tsx alert-worker.ts",
    "start:scheduler": "tsx scheduler.ts",
    "start:escalation": "tsx escalation-worker.ts",
    "start:report": "tsx report-worker.ts",
    "start:digest": "tsx digest-worker.ts",
    "dev": "concurrently -k -n check,content,alert,scheduler,escalation,report,digest,shopify -c blue,magenta,yellow,green,cyan,gray,white,red \"pnpm dev:check\" \"pnpm dev:content\" \"pnpm dev:alert\" \"pnpm dev:scheduler\" \"pnpm dev:escalation\" \"pnpm dev:report\" \"pnpm dev:digest\" \"pnpm dev:shopify\"",
    "dev:check": "tsx watch --env-file=.env.local check-worker.ts",
    "dev:content": "tsx watch --env-file=.env.local content-worker.ts",
    "dev:alert": "tsx watch --env-file=.env.local alert-worker.ts",
    "dev:scheduler": "tsx watch --env-file=.env.local scheduler.ts",
    "dev:escalation": "tsx watch --env-file=.env.local escalation-worker.ts",
    "dev:report": "tsx watch --env-file=.env.local report-worker.ts",
    "dev:digest": "tsx watch --env-file=.env.local digest-worker.ts",
    "start:shopify": "tsx shopify-feed-worker.ts",
    "dev:shopify": "tsx watch --env-file=.env.local shopify-feed-worker.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.ts\"",
    "test": "vitest run --exclude '**/*.integration.test.ts'",
    "test:integration": "vitest run --reporter=verbose check-worker.integration.test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@aws-sdk/s3-request-presigner": "^3.0.0",
    "@beaconmon/ai": "workspace:*",
    "@beaconmon/billing": "workspace:*",
    "@beaconmon/checker": "workspace:*",
    "@beaconmon/db": "workspace:*",
    "@beaconmon/logger": "workspace:*",
    "@beaconmon/queue": "workspace:*",
    "@beaconmon/status-pages": "workspace:*",
    "@beaconmon/types": "workspace:*",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.7",
    "@react-pdf/renderer": "^4.3.0",
    "@sentry/node": "^10.50.0",
    "@types/react": "^19.2.14",
    "bullmq": "^5.34.8",
    "ioredis": "^5.4.1",
    "undici": "^7.0.0",
    "react": "^19.2.5",
    "resend": "^4.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@beaconmon/tsconfig": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.17.9",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "globals": "^17.6.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
