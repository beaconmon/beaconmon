{
  "name": "@beaconmon/workers",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start:check": "tsx check-worker.ts",
    "start:content": "tsx content-worker.ts",
    "start:alert": "tsx alert-worker.ts",
    "start:scheduler": "tsx scheduler.ts",
    "dev:check": "tsx watch check-worker.ts",
    "dev:content": "tsx watch content-worker.ts",
    "dev:alert": "tsx watch alert-worker.ts",
    "dev:scheduler": "tsx watch scheduler.ts",
    "typecheck": "tsc --noEmit",
