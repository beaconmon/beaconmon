# Copy this file to .env.local and fill in values for local development.
# Never commit .env.local or any file containing real secrets.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://beaconmon:beaconmon@localhost:5432/beaconmon
# PgBouncer pooled URL for workers (use raw URL locally)
DATABASE_URL_POOLED=postgresql://beaconmon:beaconmon@localhost:5432/beaconmon

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000

# ─── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# ─── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=alerts@yourdomain.com

# ─── SMS / Twilio (tier 2 — Business plan only) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Error tracking (Sentry) ─────────────────────────────────────────────────
SENTRY_DSN=

# ─── Storage / R2 (tier 2 — reports) ─────────────────────────────────────────
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── Feature flags ───────────────────────────────────────────────────────────
# Set to true in dev to log alerts instead of sending them
ALERT_DRY_RUN=true
FEATURE_SMS_ALERTS=false
FEATURE_MULTI_LOCATION=false
FEATURE_HEARTBEAT=false
FEATURE_AGENCY=false
