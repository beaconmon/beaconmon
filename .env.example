# Copy this file to .env.local for local development.
# In production, set these in Coolify's environment-variable UI for the stack.
# Never commit .env.local or any file containing real secrets.

# ─── Database ────────────────────────────────────────────────────────────────
# Local: docker-compose Postgres (both URLs are the same).
# Production: both URLs point to the internal Docker service hostname "postgres".
# POSTGRES_USER and POSTGRES_PASSWORD must also be set so the postgres
# container initialises with the right credentials.
#   POSTGRES_USER=beaconmon
#   POSTGRES_PASSWORD=<strong-random-password>
#   DATABASE_URL=postgresql://beaconmon:<password>@postgres:5432/beaconmon
#   DATABASE_URL_POOLED=postgresql://beaconmon:<password>@postgres:5432/beaconmon
# Migrations are run from your laptop via SSH tunnel — see CLAUDE.md.
DATABASE_URL=postgresql://beaconmon:beaconmon@localhost:5432/beaconmon
DATABASE_URL_POOLED=postgresql://beaconmon:beaconmon@localhost:5432/beaconmon

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local: docker-compose Redis.
# Production: redis://redis:6379 (the in-stack service hostname).
REDIS_URL=redis://localhost:6379

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000

# ─── Freemius (billing) ──────────────────────────────────────────────────────
# API key, secret key, and public key are in your Freemius Developer Dashboard
# under Settings > API & Keys.
FREEMIUS_API_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=
FREEMIUS_WEBHOOK_SECRET=
FREEMIUS_PRODUCT_ID=
FREEMIUS_STARTER_PLAN_ID=
FREEMIUS_GROWTH_PLAN_ID=
FREEMIUS_SCALE_PLAN_ID=
FREEMIUS_SANDBOX=true
NEXT_PUBLIC_FREEMIUS_PRODUCT_ID=
NEXT_PUBLIC_FREEMIUS_STARTER_PLAN_ID=
NEXT_PUBLIC_FREEMIUS_GROWTH_PLAN_ID=
NEXT_PUBLIC_FREEMIUS_SCALE_PLAN_ID=
NEXT_PUBLIC_FREEMIUS_SANDBOX=true

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=alerts@beaconmon.com

# ─── SMS / Twilio (tier 2 — Business plan only) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Error tracking (Sentry) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_MONITOR_SLUG=beaconmon-scheduler

# ─── Storage / R2 (tier 2 — reports) ─────────────────────────────────────────
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── SEO (IndexNow) ──────────────────────────────────────────────────────────
# Enables instant URL submission to Bing, Yandex, and Naver on content changes.
# Generate a UUID: python3 -c "import uuid; print(uuid.uuid4())"
# The key is served automatically at /{key}.txt via the [slug] route handler.
NEXT_PUBLIC_INDEXNOW_KEY=

# ─── Feature flags ───────────────────────────────────────────────────────────
# Set to true in dev to log alerts instead of sending them
ALERT_DRY_RUN=true
FEATURE_SMS_ALERTS=false
FEATURE_MULTI_LOCATION=false
FEATURE_HEARTBEAT=false
FEATURE_AGENCY=false
