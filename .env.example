# Copy this file to .env.local for local development.
# In production, set these in Coolify's environment-variable UI for the stack.
# Never commit .env.local or any file containing real secrets.

# ─── Database ────────────────────────────────────────────────────────────────
# Local: docker-compose Postgres.
# Production (Neon): use the direct URL for migrations and the pooled URL for
# everything else. Neon's pooled host has "-pooler" in the hostname.
#   DATABASE_URL=postgresql://user:pass@ep-xyz.us-east-2.aws.neon.tech/beaconmon?sslmode=require
#   DATABASE_URL_POOLED=postgresql://user:pass@ep-xyz-pooler.us-east-2.aws.neon.tech/beaconmon?sslmode=require&pgbouncer=true&connection_limit=1
DATABASE_URL=postgresql://beaconmon:beaconmon@localhost:5432/beaconmon
DATABASE_URL_POOLED=postgresql://beaconmon:beaconmon@localhost:5432/beaconmon

# ─── Redis ───────────────────────────────────────────────────────────────────
# Local: docker-compose Redis.
# Production: redis://redis:6379 (the in-stack service hostname).
REDIS_URL=redis://localhost:6379

# ─── Auth (Better Auth) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
BETTER_AUTH_URL=http://localhost:3000

# ─── Freemius (billing) ──────────────────────────────────────────────────────
# API key, secret key, and public key are in your Freemius Developer Dashboard
# under Settings > API & Keys.
FREEMIUS_API_KEY=
FREEMIUS_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=
FREEMIUS_WEBHOOK_SECRET=
FREEMIUS_PRODUCT_ID=
FREEMIUS_STARTER_PLAN_ID=
FREEMIUS_GROWTH_PLAN_ID=
FREEMIUS_SCALE_PLAN_ID=
FREEMIUS_SANDBOX=true
NEXT_PUBLIC_FREEMIUS_PRODUCT_ID=
NEXT_PUBLIC_FREEMIUS_STARTER_PLAN_ID=
NEXT_PUBLIC_FREEMIUS_GROWTH_PLAN_ID=
NEXT_PUBLIC_FREEMIUS_SCALE_PLAN_ID=
NEXT_PUBLIC_FREEMIUS_SANDBOX=true

# ─── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=alerts@beaconmon.com

# ─── SMS / Twilio (tier 2 — Business plan only) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Error tracking (Sentry) ─────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_MONITOR_SLUG=beaconmon-scheduler

# ─── Storage / R2 (tier 2 — reports) ─────────────────────────────────────────
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ─── Feature flags ───────────────────────────────────────────────────────────
# Set to true in dev to log alerts instead of sending them
ALERT_DRY_RUN=true
FEATURE_SMS_ALERTS=false
FEATURE_MULTI_LOCATION=false
FEATURE_HEARTBEAT=false
FEATURE_AGENCY=false
